{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "KR"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "tng_lang"
        }
      ],
      "destination": "/ko",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/go",
      "destination": "/go.html"
    },
    {
      "source": "/img/m/:k.gif",
      "destination": "/api/track?mo=:k"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/schedule",
      "destination": "/admin-schedule.html"
    },
    {
      "source": "/ko/session",
      "destination": "/ko/session.html"
    },
    {
      "source": "/ko/poli-code",
      "destination": "/ko/poli-code.html"
    },
    {
      "source": "/ko/publishing",
      "destination": "/ko/publishing.html"
    },
    {
      "source": "/ko/briefings",
      "destination": "/ko/briefings.html"
    },
    {
      "source": "/briefings",
      "destination": "/briefings.html"
    }
  ]
}
