{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "header", "key": "x-vercel-ip-country", "value": "KR" }
      ],
      "missing": [
        { "type": "cookie", "key": "tng_lang" }
      ],
      "destination": "/ko",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/ko/briefings", "destination": "/ko/briefings.html" },
    { "source": "/briefings", "destination": "/briefings.html" }
  ]
}
